# ============================================================================
# zhixue 部署配置模板
#
# 用法 (服务器 /opt/zhixue 下):
#   cp deploy.env.example .env
#   vi .env               # 修改下面的值
# 之后 bash scripts/deploy.sh 会自动读取本项目根目录的 `.env`。
# `.env` 已被 .gitignore 忽略, 绝不提交。
# ============================================================================

# --- PostgreSQL (生产数据请务必修改) ---
# 注意: 若 pgdata 卷已用旧密码初始化过, 改这里不会改库密码, 需保持一致
POSTGRES_PASSWORD=123

# --- 账号系统 ---
# JWT 签名密钥: 不设则每次重启随机生成 (所有登录态失效)。
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 首次启动引导管理员 (仅 users 表为空时创建; 之后改这里无效)
# 首次部署请设置一个强密码, 登录后可在网页「账号设置」页修改
ADMIN_USERNAME=admin
# 初始密码 admin; 仅 users 表为空时用于引导创建 admin 账号, 登录后请立即修改
ADMIN_PASSWORD=admin

# --- 后端日志级别 (可选: INFO / WARNING / DEBUG) ---
# deploy.sh 的第 1 个参数会自动改写这里: bash scripts/deploy.sh debug
LOG_LEVEL=INFO
