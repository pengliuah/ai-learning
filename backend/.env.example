# 火山引擎方舟 (Volcengine Ark, OpenAI 兼容 / OpenAI-compatible)
# ARK_API_KEY 必填；缺失时 /api/health 返回 configured=false，生成端点返回 503
ARK_API_KEY=
# 可选，默认指向火山方舟北京区
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选，默认 doubao-1.5-pro-32k；可填推理端点 ID ep-xxx
ARK_MODEL=doubao-1.5-pro-32k
# 可选，模型单次最大输出 token；模块内容较长时建议适当调大
ARK_MAX_TOKENS=8192
# 可选，默认 INFO；设 DEBUG 输出存储层 CRUD 详细日志
LOG_LEVEL=INFO

# PostgreSQL 连接串 (必填，用于持久化学习计划数据)
# 格式: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zhixue

# IMA OpenAPI (腾讯 IMA 笔记/知识库 skill, 可选)
# 从 https://ima.qq.com/agent-interface 获取
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
