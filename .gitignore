# Android SDK (local)
.android-sdk/

# SSL certs (never commit)
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/ssl/*.crt

# server-specific compose overrides (never commit, preserved by reset --hard)
docker-compose.override.yml
docker-compose.override.*.yml
